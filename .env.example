# Supabase Public Configuration (Browser Safe)
# Note: Use the project root URL without /rest/v1/
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Supabase Server Secrets (Never exposed to browser)
SUPABASE_SECRET_KEY="your-secret-key"

# Optional Infrastructure / Provider Credentials (Deferred to respective implementation packets)
# Cloudflare R2 Storage (Deferred to OR-P04)
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET_NAME="omnirank-private-assets"

# Inngest Background Workflows (Deferred to OR-P12)
# INNGEST_EVENT_KEY="your-inngest-event-key"
# INNGEST_SIGNING_KEY="your-inngest-signing-key"

# AI Provider / OmniRouter Keys (Deferred to OR-P08)
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# OPENAI_API_KEY="your-openai-api-key"
# ANTHROPIC_API_KEY="your-anthropic-api-key"

# Application Base URL
APP_URL="http://localhost:3000"

# Development Demo Mode (STRICTLY disabled in production)
DEMO_MODE="true"
