# Supabase Public Configuration (Browser Safe)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Server Secrets (Never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Cloudflare R2 Storage (Server Only)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="omnirank-private-assets"

# Inngest Background Workflows (Server Only)
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# AI Provider / OmniRouter Keys (Server Only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Application Base URL
APP_URL="http://localhost:3000"
